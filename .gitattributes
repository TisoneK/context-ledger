# Line-ending policy for the Context Ledger protocol package.
#
# The core is integrity-checked byte-for-byte against core/MANIFEST.sha256,
# whose hashes are computed over LF bytes. If a Windows checkout with
# core.autocrlf=true rewrites these files to CRLF, every hash mismatches and
# the sh manifest parser dies on '\r'-suffixed filenames.
# Forcing eol=lf keeps the working tree byte-identical to the manifest on
# every platform. PowerShell and Git Bash both read LF without issue.
#
# This file lives OUTSIDE core/, so it is never itself hashed by the manifest.

# Everything text-ish is LF, everywhere.
* text=auto eol=lf

# Belt-and-suspenders for the integrity-critical and executable files.
core/**            text eol=lf
core/MANIFEST.sha256 text eol=lf
core/bin/*         text eol=lf
*.sh               text eol=lf
*.ps1              text eol=lf
*.md               text eol=lf
*.json             text eol=lf
*.conf             text eol=lf
*.lock             text eol=lf

# --- Append-only ledger logs: union-merge on conflict --------------------
# This package dogfoods its own protocol under .context_ledger/. These logs
# are append-only, so concurrent sessions and sibling cohorts always conflict
# on them at merge; git's union driver keeps both sides' appended entries and
# drops the markers. Regenerate STATE.md afterward with `ledger-state
# reconcile` (STATE.md is derived and never union-merged). Mirrors
# core/templates/.gitattributes, which ships the same rules to every project.
.context_ledger/memory/office/agents/sessions.md     merge=union
.context_ledger/memory/office/flaws/log.md           merge=union
.context_ledger/memory/office/inefficiencies/log.md  merge=union
.context_ledger/memory/office/plans/decisions.md     merge=union

# Binary assets must never be normalized.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.pdf  binary
*.ico  binary
*.db   binary
